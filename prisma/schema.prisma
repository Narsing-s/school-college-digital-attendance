generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum InstitutionType { SCHOOL COLLEGE }
enum UserRole { SUPER_ADMIN ADMIN PRINCIPAL TEACHER STUDENT PARENT }
enum UserStatus { ACTIVE INACTIVE }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED LEAVE }
enum AttendanceMethod { MANUAL QR ROLL_NUMBER }
enum SessionStatus { OPEN CLOSED }
enum LatePolicy { PRESENT SEPARATE HALF_DAY }
enum LeaveStatus { PENDING APPROVED REJECTED CANCELLED }

model Institution {
 id String @id @default(cuid())
 name String
 code String @unique
 type InstitutionType
 timezone String @default("Asia/Kolkata")
 minAttendancePercent Float @default(75)
 latePolicy LatePolicy @default(SEPARATE)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 campuses Campus[]
 academicYears AcademicYear[]
 departments Department[]
 classes ClassLevel[]
 sections Section[]
 subjects Subject[]
 users User[]
 students Student[]
 teachers Teacher[]
 parents Parent[]
 enrollments Enrollment[]
 assignments TeacherAssignment[]
 timetables Timetable[]
 sessions AttendanceSession[]
 records AttendanceRecord[]
 syncOperations AttendanceSyncOperation[]
 leaves LeaveRequest[]
 notifications Notification[]
 auditLogs AuditLog[]
 syncOperations AttendanceSyncOperation[]
}
model Campus { id String @id @default(cuid()); institutionId String; name String; code String; address String?; status UserStatus @default(ACTIVE); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); academicYears AcademicYear[]; @@unique([institutionId,code]) }
model AcademicYear { id String @id @default(cuid()); institutionId String; campusId String?; name String; startDate DateTime; endDate DateTime; isCurrent Boolean @default(false); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); campus Campus? @relation(fields:[campusId],references:[id],onDelete:SetNull); enrollments Enrollment[]; assignments TeacherAssignment[]; timetables Timetable[]; sessions AttendanceSession[]; @@unique([institutionId,name]); @@index([institutionId,isCurrent]) }
model Department { id String @id @default(cuid()); institutionId String; name String; code String; status UserStatus @default(ACTIVE); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); classes ClassLevel[]; subjects Subject[]; teachers Teacher[]; @@unique([institutionId,code]) }
model ClassLevel { id String @id @default(cuid()); institutionId String; departmentId String?; name String; code String; type InstitutionType; institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); department Department? @relation(fields:[departmentId],references:[id],onDelete:SetNull); sections Section[]; subjects Subject[]; attendanceSessions AttendanceSession[]; @@unique([institutionId,code]) }
model Section { id String @id @default(cuid()); institutionId String; classLevelId String; name String; capacity Int @default(60); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); classLevel ClassLevel @relation(fields:[classLevelId],references:[id],onDelete:Cascade); enrollments Enrollment[]; assignments TeacherAssignment[]; timetables Timetable[]; sessions AttendanceSession[]; @@unique([classLevelId,name]) }
model Subject { id String @id @default(cuid()); institutionId String; classLevelId String?; departmentId String?; code String; name String; credits Int?; institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); classLevel ClassLevel? @relation(fields:[classLevelId],references:[id],onDelete:SetNull); department Department? @relation(fields:[departmentId],references:[id],onDelete:SetNull); assignments TeacherAssignment[]; timetables Timetable[]; sessions AttendanceSession[]; @@unique([institutionId,code]) }
model User { id String @id @default(cuid()); institutionId String?; email String?; emailVerifiedAt DateTime?; username String @unique; passwordHash String; role UserRole; status UserStatus @default(ACTIVE); lastLoginAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; institution Institution? @relation(fields:[institutionId],references:[id],onDelete:SetNull); student Student?; teacher Teacher?; parent Parent?; notifications Notification[]; auditLogs AuditLog[]; sessions Session[]; passwordResetTokens PasswordResetToken[]; emailVerificationTokens EmailVerificationToken[]; @@index([institutionId,role]) }
model Student { id String @id @default(cuid()); institutionId String; userId String? @unique; admissionNumber String; rollNumber String?; firstName String; lastName String?; dob DateTime?; dateOfBirth DateTime?; gender String?; email String?; phone String?; guardianName String?; guardianPhone String?; status UserStatus @default(ACTIVE); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); enrollments Enrollment[]; attendanceRecords AttendanceRecord[]; leaves LeaveRequest[]; parents ParentStudent[]; @@unique([institutionId,admissionNumber]); @@index([institutionId,rollNumber]) }
model Teacher { id String @id @default(cuid()); institutionId String; userId String @unique; employeeId String; name String?; email String?; departmentId String?; phone String?; status UserStatus @default(ACTIVE); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); department Department? @relation(fields:[departmentId],references:[id],onDelete:SetNull); assignments TeacherAssignment[]; timetables Timetable[]; sessions AttendanceSession[]; @@unique([institutionId,employeeId]) }
model Parent { id String @id @default(cuid()); institutionId String; userId String @unique; phone String?; institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); students ParentStudent[] }
model ParentStudent { parentId String; studentId String; relationship String @default("Guardian"); parent Parent @relation(fields:[parentId],references:[id],onDelete:Cascade); student Student @relation(fields:[studentId],references:[id],onDelete:Cascade); @@id([parentId,studentId]) }
model Enrollment { id String @id @default(cuid()); institutionId String; academicYearId String; studentId String; sectionId String; rollNumber String?; status UserStatus @default(ACTIVE); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade); student Student @relation(fields:[studentId],references:[id],onDelete:Cascade); section Section @relation(fields:[sectionId],references:[id],onDelete:Cascade); @@unique([academicYearId,studentId]); @@index([sectionId,academicYearId]) }
model TeacherAssignment { id String @id @default(cuid()); institutionId String; academicYearId String; teacherId String; subjectId String; sectionId String; institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade); teacher Teacher @relation(fields:[teacherId],references:[id],onDelete:Cascade); subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade); section Section @relation(fields:[sectionId],references:[id],onDelete:Cascade); @@unique([academicYearId,teacherId,subjectId,sectionId]) }
model Timetable { id String @id @default(cuid()); institutionId String; academicYearId String; sectionId String; subjectId String; teacherId String; dayOfWeek Int; startTime String; endTime String; room String?; institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade); section Section @relation(fields:[sectionId],references:[id],onDelete:Cascade); subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade); teacher Teacher @relation(fields:[teacherId],references:[id],onDelete:Cascade); @@index([sectionId,dayOfWeek]) }
model AttendanceSession { id String @id @default(cuid()); institutionId String; academicYearId String; classId String?; sectionId String; subjectId String?; teacherId String?; date DateTime; startTime String?; endTime String?; method AttendanceMethod @default(MANUAL); status SessionStatus @default(OPEN); latePolicy LatePolicy @default(SEPARATE); createdBy String; createdAt DateTime @default(now()); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); academicYear AcademicYear @relation(fields:[academicYearId],references:[id],onDelete:Cascade); class ClassLevel? @relation(fields:[classId],references:[id],onDelete:SetNull); section Section @relation(fields:[sectionId],references:[id],onDelete:Cascade); subject Subject? @relation(fields:[subjectId],references:[id],onDelete:SetNull); teacher Teacher? @relation(fields:[teacherId],references:[id],onDelete:SetNull); records AttendanceRecord[]; @@index([institutionId,date]); @@index([sectionId,date]) }
model AttendanceRecord { id String @id @default(cuid()); institutionId String; sessionId String; studentId String; status AttendanceStatus; markedAt DateTime @default(now()); updatedAt DateTime @updatedAt; markedBy String; remarks String?; institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); session AttendanceSession @relation(fields:[sessionId],references:[id],onDelete:Cascade); student Student @relation(fields:[studentId],references:[id],onDelete:Cascade); @@unique([sessionId,studentId]); @@index([institutionId,studentId]) }
model LeaveRequest { id String @id @default(cuid()); institutionId String; studentId String; fromDate DateTime; toDate DateTime; reason String; status LeaveStatus @default(PENDING); approvedBy String?; approvedAt DateTime?; createdAt DateTime @default(now()); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); student Student @relation(fields:[studentId],references:[id],onDelete:Cascade); @@index([institutionId,status]) }
model Notification { id String @id @default(cuid()); institutionId String; userId String; type String; title String; message String; readAt DateTime?; createdAt DateTime @default(now()); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,readAt]) }
model AuditLog { id String @id @default(cuid()); institutionId String; actorUserId String; userId String?; action String; entityType String; entity String?; entityId String; oldValue Json?; newValue Json?; reason String?; timestamp DateTime?; ip String?; userAgent String?; deviceId String?; deviceName String?; createdAt DateTime @default(now()); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); actor User @relation(fields:[actorUserId],references:[id],onDelete:Cascade); @@index([institutionId,createdAt]) }
model Session { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; createdAt DateTime @default(now()); lastSeenAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,expiresAt]) }
model EmailVerificationToken { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; verifiedAt DateTime?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,expiresAt]) }
model PasswordResetToken { id String @id @default(cuid()); userId String; tokenHash String @unique; expiresAt DateTime; usedAt DateTime?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,expiresAt]) }
model AttendanceSyncOperation { id String @id @default(cuid()); operationId String @unique; institutionId String; userId String; sessionId String; createdAt DateTime @default(now()); institution Institution @relation(fields:[institutionId],references:[id],onDelete:Cascade); session AttendanceSession @relation(fields:[sessionId],references:[id],onDelete:Cascade); @@index([institutionId,createdAt]) }
